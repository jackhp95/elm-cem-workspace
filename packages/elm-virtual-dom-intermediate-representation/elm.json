{
    "type": "package",
    "name": "jackhp95/elm-virtual-dom-intermediate-representation",
    "summary": "Phantom-typed HTML IR: the shared substrate for elm-cem generated UI libraries",
    "license": "BSD-3-Clause",
    "version": "1.1.0",
    "exposed-modules": [
        "HtmlIr.Element",
        "HtmlIr.Node",
        "HtmlIr.Attribute",
        "HtmlIr.Value",
        "HtmlIr.Kind",
        "HtmlIr.Query",
        "HtmlIr.Internal"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.0 <= v < 2.0.0",
        "elm/html": "1.0.0 <= v < 2.0.0",
        "elm/json": "1.0.0 <= v < 2.0.0",
        "elm/virtual-dom": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.0.0 <= v < 3.0.0"
    }
}
