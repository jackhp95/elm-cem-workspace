-- EXPECTED MESSAGES (mirrors of the rule's, so a wording change breaks loudly)


fromHtmlAttribute : String
fromHtmlAttribute =
    "M3e.Unsafe.Attributes.fromHtmlAttribute"


customAttribute : String
customAttribute =
    "M3e.Unsafe.Attributes.customAttribute"


attributeMessage : String -> String -> String -> String
attributeMessage escape subject setter =
    "Redundant escape: `" ++ escape ++ "` writes the `" ++ subject ++ "` attribute, which `" ++ setter ++ "` already provides"


eventMessage : String -> String -> String -> String
eventMessage escape subject setter =
    "Redundant escape: `" ++ escape ++ "` wires the `" ++ subject ++ "` event, which `" ++ setter ++ "` already provides"


expectedDetails : String -> String -> String -> Bool -> List String
expectedDetails escape subject setter fixable =
    [ "`"
        ++ escape
        ++ "` produces an `Attr` with a FREE capability row, so the compiler no longer checks which elements admit `"
        ++ subject
        ++ "`. `"
        ++ setter
        ++ "` is the typed setter for it: it carries the capability the element's closed row must list, so a misplaced attribute is a compile error instead of a silent no-op."
    , "Use `"
        ++ setter
        ++ "` and reserve `"
        ++ escape
        ++ "` for what the typed layer genuinely cannot express — a custom-element attribute with no generated setter."
    ]
        ++ (if fixable then
                []

            else
                [ "No autofix here: the escape's value has to be translated into `" ++ setter ++ "`'s argument (a value token, a decoder, or a different arity), which is a human decision." ]
           )
