{
    "type": "package",
    "name": "jackhp95/elm-review-cem",
    "summary": "Namespace-agnostic, codegen-aware elm-review rules driven by CEM facts",
    "license": "BSD-3-Clause",
    "version": "1.0.0",
    "exposed-modules": [
        "Cem",
        "NoSeamOutsideAllowedModules",
        "NoNonLayoutTailwindClasses",
        "NoInternalImportOutsideAllowed",
        "NoUnsafeImportOutsideAllowed",
        "NoRedundantElementForge",
        "NoRedundantElementEscape",
        "NoRedundantAttributeEscape",
        "NoMergedPipeAndSetter",
        "NoMissingComponentApiNames",
        "ExtractToSeam",
        "Cem.PreferBarrel",
        "Cem.TranslateToRecord",
        "Cem.TranslateToBuild",
        "Cem.PreferComponentSetters",
        "Cem.PreferComponentModules",
        "Cem.RequireSlot",
        "Cem.SingularSlot",
        "Cem.SingularAttribute",
        "Cem.MissingRequiredAttribute",
        "Cem.RequireFabLabel",
        "Cem.RequireFormFieldLabel",
        "Cem.MissingRequiredSingularSlot",
        "Cem.ValidEnumValue",
        "Cem.ValidSlotKind"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.0 <= v < 2.0.0",
        "jackhp95/elm-cem-facts": "1.0.0 <= v < 2.0.0",
        "jfmengels/elm-review": "2.16.0 <= v < 3.0.0",
        "stil4m/elm-syntax": "7.3.0 <= v < 8.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.0.0 <= v < 3.0.0"
    }
}
