{
  "schemaVersion": "1.0.0",
  "package": { "name": "wc-widgets", "version": "1.0.0" },
  "_config": {
    "Widget": {
      "slots": {
        "icon": { "kinds": ["icon"] },
        "leading": { "kinds": ["icon"] },
        "leading-icon": { "kinds": "arbitrary" },
        "unnamed": { "kinds": "arbitrary" },
        "label": { "kinds": "arbitrary" }
      }
    },
    "Progress": {
      "group": { "circular": "wc-circular", "linear": "wc-linear" }
    }
  },
  "modules": [
    {
      "kind": "javascript-module",
      "path": "widget.js",
      "declarations": [
        {
          "kind": "class",
          "name": "WcWidget",
          "tagName": "wc-widget",
          "customElement": true,
          "description": "A generic widget.",
          "members": [], "events": [], "cssProperties": [], "cssParts": [], "cssStates": [],
          "slots": [
            { "name": "icon" },
            { "name": "leading" },
            { "name": "leading-icon" },
            { "name": "unnamed" },
            { "name": "label" }
          ],
          "attributes": [
            { "name": "mode", "type": { "text": "'assisted' | 'auto' | 'manual'" }, "description": "Non-colliding enum (case-collision scenario moved to expectError suite)." },
            { "name": "label", "type": { "text": "string" }, "description": "A label." },
            { "name": "disabled", "type": { "text": "boolean" }, "fieldName": "disabled", "description": "Reflected bool WITH a fieldName — WS1a: defaults to the kebab HTML attribute." },
            { "name": "no-header", "type": { "text": "boolean" }, "description": "Hyphenated bool with NO fieldName (#33 regression check)." },
            { "name": "count", "type": { "text": "number" }, "description": "A numeric attribute." },
            { "name": "value", "type": { "text": "string" }, "description": "The current value." },
            { "name": "name", "type": { "text": "string" }, "description": "The field name." }
          ]
        },
        {
          "kind": "class",
          "name": "WcMenuTrigger",
          "tagName": "wc-menu-trigger",
          "customElement": true,
          "description": "Opens a menu.",
          "members": [], "events": [], "slots": [], "cssProperties": [], "cssParts": [], "cssStates": [],
          "attributes": [
            { "name": "for", "type": { "text": "string" }, "description": "Id of the menu it opens." },
            { "name": "value", "type": { "text": "string" }, "description": "The current value." },
            { "name": "name", "type": { "text": "string" }, "description": "The field name." }
          ]
        },
        {
          "kind": "class",
          "name": "WcIcon",
          "tagName": "wc-icon",
          "customElement": true,
          "description": "An icon (buildable child for the `icon` kind — M5b slot-helper collision regression).",
          "members": [], "events": [], "slots": [], "cssProperties": [], "cssParts": [], "cssStates": [],
          "attributes": [
            { "name": "name", "type": { "text": "string" }, "description": "The icon name." }
          ]
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "progress.js",
      "declarations": [
        {
          "kind": "class",
          "name": "WcCircular",
          "tagName": "wc-circular",
          "customElement": true,
          "description": "A circular progress indicator (variant-group member).",
          "members": [], "events": [], "slots": [], "cssProperties": [], "cssParts": [], "cssStates": [],
          "attributes": [
            { "name": "value", "type": { "text": "number" }, "description": "Progress 0..1." }
          ]
        },
        {
          "kind": "class",
          "name": "WcLinear",
          "tagName": "wc-linear",
          "customElement": true,
          "description": "A linear progress indicator (variant-group member).",
          "members": [], "events": [], "slots": [], "cssProperties": [], "cssParts": [], "cssStates": [],
          "attributes": [
            { "name": "value", "type": { "text": "number" }, "description": "Progress 0..1." }
          ]
        }
      ]
    }
  ]
}
