# Normalize line endings.
* text=auto eol=lf

# Keep dev-only paths out of `git archive` source tarballs (npm uses its own `files`
# allowlist; this only affects git archives).
/tests                export-ignore
/RELEASE-CHECKLIST.md export-ignore
/CONTRIBUTING.md      export-ignore
/CODE_OF_CONDUCT.md   export-ignore
/.github              export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore
node_modules          export-ignore
elm-stuff             export-ignore

# Treat lock files as generated in diffs / language stats.
package-lock.json     linguist-generated=true
