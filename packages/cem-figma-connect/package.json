{
  "name": "cem-figma-connect",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Merge a CEM (custom-elements manifest) with a Figma library export to generate Figma Code Connect.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 'test/**/*.test.mjs' 'src/**/*.test.mjs'",
    "gen:facts": "node scripts/gen-facts.mjs",
    "gen:match": "node src/cli.mjs match --profile m3-kit",
    "gen:emit": "node src/cli.mjs emit --profile m3-kit",
    "gen:gap": "node src/cli.mjs gap --profile m3-kit",
    "gen:links": "node src/cli.mjs links --profile m3-kit",
    "publish:cc": "node src/cli.mjs publish",
    "check": "run-p \"check:*\"",
    "check:drift": "node src/cli.mjs check --profile m3-kit",
    "check:facts": "node scripts/check-facts.mjs --profile m3-kit",
    "check:links": "node scripts/check-links.mjs --profile m3-kit",
    "check:tokens": "node src/tokens/derive.mjs --check",
    "check:token-graph": "node src/tokens/graph.mjs --check",
    "check:token-change-report": "node src/tokens/token-change-report.mjs --check",
    "check:render": "node src/visual/harness/selfcheck.mjs",
    "gate": "run-s check test",
    "hooks:install": "node ../../tools/hooks-install.mjs"
  },
  "dependencies": {
    "@figma/code-connect": "^1.4.9",
    "elm-cem": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.2.45",
    "@fontsource/roboto": "^5.2.10",
    "@m3e/web": "2.7.3",
    "culori": "4.0.2",
    "esbuild": "^0.28.1",
    "npm-run-all2": "^9.0.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0"
  }
}
