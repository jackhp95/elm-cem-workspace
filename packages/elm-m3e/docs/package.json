{
  "name": "m3e-builder-docs",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "postinstall": "node scripts/fix-native-bins.mjs",
    "gen": "run-s gen:vendor gen:icons gen:brand-images gen:reference gen:examples-config gen:examples-surfaces gen:examples-barrel gen:examples gen:samples",
    "gen:vendor": "run-s gen:vendor-foundation gen:vendor-tailwind",
    "gen:vendor-foundation": "node scripts/vendor-foundation.mjs",
    "gen:vendor-tailwind": "node scripts/vendor-tailwind-m3e-web.mjs",
    "gen:icons": "node scripts/icons-gen/icons-to-js.mjs",
    "gen:brand-images": "node scripts/icons-gen/brand-images.mjs && node scripts/icons-gen/tangram-favicon.mjs",
    "gen:reference": "node scripts/extract-reference.mjs",
    "gen:examples-config": "node scripts/examples-gen/examples-to-elm.mjs",
    "gen:examples-surfaces": "node scripts/examples-gen/gen-record-build.mjs",
    "gen:examples-barrel": "node scripts/examples-gen/gen-barrel.mjs",
    "gen:examples": "node scripts/build-examples-data.mjs",
    "gen:examples-source": "node scripts/examples-gen/extract-matraic-examples.mjs",
    "gen:samples": "node scripts/samples-gen/extract-samples.mjs",
    "gen:compose-attrs": "node scripts/gen-compose-attrs.mjs",
    "gen:pages": "elm-pages gen",
    "build:site": "elm-pages build && node scripts/search-index-gen/build-search-index.mjs",
    "build:ci": "pnpm run gen:reference && pnpm run check:nav && pnpm run build:site",
    "test:examples-gen": "node --test scripts/examples-gen/lib/*.test.mjs",
    "test:samples-gen": "node --test scripts/samples-gen/lib/*.test.mjs",
    "test:roundtrip": "node --test scripts/roundtrip/*.test.mjs",
    "test:icons-gen": "node --test scripts/icons-gen/*.test.mjs",
    "test:search-index-gen": "node --test scripts/search-index-gen/*.test.mjs",
    "test:worktree-port": "node --test scripts/worktree-port.test.mjs",
    "pretest:browser": "node scripts/kill-stale-server.mjs",
    "test:browser": "node scripts/browser-guard.mjs",
    "check:nav": "node scripts/check-nav.mjs",
    "check:drift": "node scripts/check-data-drift.mjs",
    "check:vendor": "node scripts/check-vendor-drift.mjs",
    "check:samples": "node scripts/samples-gen/verify-samples.mjs",
    "check:roundtrip": "node scripts/verify-roundtrip.mjs",
    "check:compose-attrs": "node scripts/gen-compose-attrs.mjs --check",
    "dev": "elm-pages dev",
    "serve": "node scripts/serve-dist.mjs dist",
    "check:review": "node scripts/check-review-guard.mjs"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.88",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/utils": "^3.1.4",
    "@material/material-color-utilities": "0.4.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "elm": "^0.19.1-6",
    "elm-format": "^0.8.8",
    "elm-pages": "^3.5.0",
    "elm-review": "^2.13.5",
    "lamdera": "^0.19.1-1.4.0",
    "npm-run-all2": "^9.0.3",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@m3e/web": "2.7.6",
    "linkedom": "^0.18.13",
    "tslib": "^2.8.1"
  }
}
