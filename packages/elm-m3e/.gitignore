node_modules/
elm-stuff/
dist/
dist-packages/
.DS_Store
*.log

.playwright-mcp/
*.png

# ...except the generated Open Graph card. It is a build artifact of
# docs/scripts/icons-gen/brand-images.mjs, but it must be TRACKED: 14 route
# modules serve it as their og:image, so an untracked one is a 404 on every
# shared link. It is deliberately excluded from check:drift instead — see the
# note in docs/scripts/check-data-drift.mjs.
!docs/public/og-card.png

# Agent / session working artifacts and stale generator snapshots (see issue #82).
# gen-sample/ was a hand-committed snapshot of generated modules that drifted
# from src; the rest are local agent/session scratch state.
gen-sample/
scratchpad/
memory/
.claude/

# Editor-local LSP config. .zed/settings.json pins elm-language-server at
# docs/elm.json through an absolute file:// URI, because the root elm.json
# depends on two unpublished packages and so shadows every nested elm.json
# with a workspace that cannot resolve. That makes the file machine-specific.
.zed/

# working clone of the matraic m3e-docs wiki (regen input; not part of this repo)
/m3e-docs/

# also ignore node_modules symlinks (not just dirs)
node_modules

# elm publish doc-build artifact (write to /tmp instead)
docs.json

# The elm-cem generator is cloned here by CI/regen workflows; never commit it.
elm-cem/
