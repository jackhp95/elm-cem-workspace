{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jackhp95/elm-cem-workspace/docs/svg-audit/spec-index.schema.json",
  "title": "SVG 2 spec-index",
  "description": "Machine-readable SVG 2 element + attribute vocabulary for the elm-typed-svg API-vs-spec audit (plan Task 1). Validates docs/svg-audit/spec-index.json.",
  "type": "object",
  "required": ["provenance", "counts", "elements", "attributes"],
  "additionalProperties": true,
  "properties": {
    "_comment": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["specUrls", "fetchedAt"],
      "additionalProperties": true,
      "properties": {
        "specUrls": { "type": "array", "items": { "type": "string", "format": "uri" }, "minItems": 1 },
        "crossCheckedAgainst": { "type": "array", "items": { "type": "string" } },
        "fetchedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "specStatus": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "required": ["elements", "attributesTotal"],
      "additionalProperties": true,
      "properties": {
        "elements": { "type": "integer", "minimum": 1 },
        "presentationProperties": { "type": "integer", "minimum": 0 },
        "finiteEnumPresentationProperties": { "type": "integer", "minimum": 0 },
        "attributesTotal": { "type": "integer", "minimum": 1 }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "family", "specHref"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "family": {
            "type": "string",
            "enum": ["static-render", "filter", "smil-animation", "non-rendering-metadata", "html-embed"]
          },
          "specHref": { "type": "string", "minLength": 1 },
          "inMdnReference": { "type": "boolean" }
        }
      }
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "family", "appliesTo"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "family": {
            "type": "string",
            "enum": ["core", "presentation", "filter-presentation", "conditional-processing", "xlink", "filter", "animation-timing", "animation-value", "animation-addition", "geometry", "event", "aria"]
          },
          "appliesTo": { "type": "array", "items": { "type": "string" } },
          "valueGrammar": { "type": ["string", "null"] },
          "finiteEnum": { "type": "boolean" }
        }
      }
    }
  }
}
