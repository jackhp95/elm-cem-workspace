{
  "name": "elm-cem",
  "version": "0.3.1",
  "description": "Generate type-safe, phantom-typed Elm bindings from a web component library's Custom Elements Manifest. Emits one <Lib>.* brand (general surface + strict per-component modules + shared Attributes/Events/Values/Kind + Review.Facts).",
  "author": "jackhp95",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackhp95/elm-cem.git"
  },
  "bugs": {
    "url": "https://github.com/jackhp95/elm-cem/issues"
  },
  "homepage": "https://github.com/jackhp95/elm-cem#readme",
  "keywords": [
    "elm",
    "codegen",
    "custom-elements",
    "custom-elements-manifest",
    "cem",
    "web-components",
    "bindings",
    "type-safe",
    "elm-codegen",
    "design-system"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "elm-cem": "./bin/elm-cem.js"
  },
  "exports": {
    "./elm-shape": "./src/elm-shape.mjs"
  },
  "files": [
    "codegen/",
    "bin/",
    "templates/",
    "cem-configs/",
    "data/",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!codegen/elm-stuff"
  ],
  "scripts": {
    "test:elm": "elm-test-rs --project tests tests/src/*.elm",
    "test:phantom": "node tests/phantom/gate.mjs",
    "test:facts-bundle-schema": "node tests/facts-bundle-schema.test.mjs",
    "test:exclude-cli": "node tests/exclude-cli.test.mjs",
    "test:renames-cli": "node tests/renames-cli.test.mjs",
    "test:split": "node tests/split.test.mjs",
    "test:depstamp": "node tests/depstamp.test.mjs",
    "test:eject": "node tests/eject.test.mjs",
    "test:attr-property": "node tests/attr-property.test.mjs",
    "test:enum-override": "node tests/enum-override.test.mjs",
    "test:from-string": "node tests/from-string.test.mjs",
    "test:elm-shape": "node --test tests/elm-shape.test.mjs",
    "test:gates": "node tests/gates.test.mjs",
    "test:registry-nested-pkg": "node tests/registry-check-nested-pkg.test.mjs",
    "test:check-gates": "node tests/check-gates.test.mjs",
    "test:bin-entrypoints": "node tests/bin-entrypoints.test.mjs",
    "test:brand-sync": "node tests/brand-sync.test.mjs",
    "check:format": "elm-format tests/src --validate",
    "check:gates": "node bin/elm-cem.js check-gates",
    "check:neutrality": "bash .github/neutrality-check.sh",
    "check:skills": "node skills/check-skills.mjs",
    "test": "run-p \"test:*\"",
    "check": "run-p \"check:*\"",
    "gate": "run-s check test",
    "format": "elm-format tests/src --yes",
    "bless": "node tests/phantom/bless.mjs",
    "setup": "elm-tooling install",
    "prepublishOnly": "npm run gate",
    "hooks:install": "node ../../tools/hooks-install.mjs"
  },
  "dependencies": {
    "elm-codegen": "^0.6.3"
  },
  "devDependencies": {
    "elm-tooling": "^1.20.0",
    "npm-run-all2": "^8.0.4"
  }
}
