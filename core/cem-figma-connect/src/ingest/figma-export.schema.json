{
  "$comment": "figma-export.json — the ONE deterministic per-Figma-file JSON the whole pipeline consumes (D9). Validated with the hand-rolled checker in src/lib/validate.mjs (type/enum/required/properties/additionalProperties/items only — no $ref/oneOf/patternProperties).",
  "type": "object",
  "required": ["meta", "components", "setProperties", "variables", "styles"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["fileKey", "fileName", "extractedAt", "kitVersionTag"],
      "additionalProperties": false,
      "properties": {
        "fileKey": { "type": "string" },
        "fileName": { "type": "string" },
        "extractedAt": {
          "type": "string",
          "$comment": "Passed in by the extractor invocation, never computed at load/build time (determinism)."
        },
        "kitVersionTag": {
          "type": "string",
          "$comment": "Passed in by the extractor invocation, never computed at load/build time (determinism)."
        }
      }
    },
    "components": {
      "type": "array",
      "$comment": "Flat array, exactly the 6-field shape of research/figma-dumps/m3-kit-components.json.",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "key", "description", "page"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["COMPONENT", "COMPONENT_SET"] },
          "key": {
            "type": "string",
            "$comment": "Retained but downstream code MUST treat it as per-fileKey cache (evidence #5) — duplicating a file mints new keys."
          },
          "description": { "type": "string" },
          "page": { "type": "string" }
        }
      }
    },
    "setProperties": {
      "type": "object",
      "$comment": "Keyed by COMPONENT_SET node id. Optional PER-SET: A2's fixture only has the two captured button sets; A3's live extractor fills all 171. Do not hard-require an entry for every set id.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "type", "defaultValue"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "$comment": "Raw property name, exactly as Figma returns it. Non-variant properties carry a '#id' suffix (e.g. \"Label text#58653:0\"); VARIANT properties do not. The loader derives rawName/displayName from this."
            },
            "type": {
              "type": "string",
              "enum": ["VARIANT", "TEXT", "BOOLEAN", "INSTANCE_SWAP", "SLOT"],
              "$comment": "Figma's component-property types. SLOT was added after the 2-set offline fixture — the live M3 kit (2026-07-13 extraction) uses SLOT props on several components (menus, lists, etc.); the offline fixture never exercised it. SLOT is not mapped by the current matcher/emitter surface (button tracer uses VARIANT/TEXT/BOOLEAN/INSTANCE_SWAP only) but must validate so full-file extraction succeeds."
            },
            "defaultValue": { "type": ["string", "boolean", "number"] },
            "variantOptions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "preferredValues": {
              "type": "array"
            }
          }
        }
      }
    },
    "variables": {
      "type": "object",
      "required": ["collections", "variables"],
      "additionalProperties": false,
      "properties": {
        "collections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "modes"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "modes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "name"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "resolvedType",
              "collectionId",
              "valuesByMode",
              "codeSyntax",
              "scopes"
            ],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "resolvedType": {
                "type": "string",
                "enum": ["COLOR", "STRING", "FLOAT", "BOOLEAN"]
              },
              "collectionId": { "type": "string" },
              "valuesByMode": {
                "type": "object",
                "$comment": "Keyed by mode id. Value shape depends on resolvedType (COLOR -> {r,g,b,a}, STRING -> string, FLOAT -> number) so it is intentionally unconstrained here.",
                "additionalProperties": {}
              },
              "codeSyntax": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "scopes": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "styles": {
      "type": "object",
      "$comment": "Pass-through of kit-styles.json shapes.",
      "required": ["paintStyles", "textStyles", "effectStyles"],
      "additionalProperties": false,
      "properties": {
        "paintStyles": { "type": "array" },
        "textStyles": { "type": "array" },
        "effectStyles": { "type": "array" }
      }
    }
  }
}
