# Normalize line endings.
* text=auto eol=lf

# Keep dev-only paths out of `git archive` / published package tarballs.
/tests                export-ignore
/review               export-ignore
/docs                 export-ignore
/.github              export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore
/elm-tooling.json     export-ignore
/.neutrality-allowlist export-ignore
/CONTRIBUTING.md      export-ignore
/CODE_OF_CONDUCT.md   export-ignore
/SECURITY.md          export-ignore
elm-stuff             export-ignore
