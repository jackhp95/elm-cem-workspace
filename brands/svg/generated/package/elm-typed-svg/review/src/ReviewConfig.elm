module ReviewConfig exposing (config)

{-| elm-review configuration for elm-typed-svg.

All of `src/` is generated by elm-cem — style, documentation, and unused rules
must not gate on it. The facts-driven Cem.\* rules (ValidEnumValue, RequireSlot,
etc.) run on consumer code only; the generated library itself is excluded.

`Cem.validComposition` is the reason this brand needs a `check:review` at all
(families/a11y plan Task 6): the SVG-AAM overlay it carries — a `role` /
`aria-roledescription` attribute setter on a non-rendered svg element (`defs`,
`clipPath`, `mask`, `pattern`, `filter`, `animate*`, `set`, `discard`) — has no
other enforcement point. It is brand-agnostic and pulls its non-rendered-element
set and role-setter-name table from `Cem.ValidComposition.defaultConfig`, keyed
by this brand's own generated component nouns (`defs`, `g`, …) and its own
`TypedSvg.Attributes.role` / `TypedSvg.Attributes.ariaRoledescription` setters
(both open-row `_globals`, see `../../../../../inputs/config.json`).

Run from the repo root:

    pnpm --filter elm-typed-svg run check:review

-}

import Cem
import NoDebug.Log
import NoDebug.TodoOrToString
import NoUnused.CustomTypeConstructorArgs
import NoUnused.CustomTypeConstructors
import NoUnused.Exports
import NoUnused.Modules
import NoUnused.Parameters
import NoUnused.Patterns
import NoUnused.Variables
import Review.Rule as Rule exposing (Rule)
import Simplify
import TypedSvg.Review.Facts


config : List Rule
config =
    List.map ignoreGenerated correctness
        ++ List.map (ignoreGenerated >> ignoreVerifyFixtures) unused
        ++ List.map (ignoreGenerated >> ignoreVerifyFixtures) codegenAware


{-| All of `src/` is generated wholesale — exclude it from every rule.
-}
ignoreGenerated : Rule -> Rule
ignoreGenerated =
    Rule.ignoreErrorsForDirectories [ "src/" ]


{-| The verify fixtures in `verify/` are standalone compile-time probes — they
are never imported by anything, so unused-module/export rules always fire on
them falsely. Exclude them from all unused and cem-usage rules.
-}
ignoreVerifyFixtures : Rule -> Rule
ignoreVerifyFixtures =
    Rule.ignoreErrorsForDirectories [ "verify/" ]


{-| Correctness rules — run everywhere (verify probes included, so Debug sneaking
into a probe is caught).
-}
correctness : List Rule
correctness =
    [ Simplify.rule Simplify.defaults
    , NoDebug.Log.rule
    , NoDebug.TodoOrToString.rule
    ]


{-| Unused-code rules. The brand's public API is entirely in generated `src/`,
so there is no hand-written public surface to gate on here. The verify fixtures
are also excluded (see ignoreVerifyFixtures).
-}
unused : List Rule
unused =
    [ NoUnused.Variables.rule
    , NoUnused.CustomTypeConstructors.rule []
    , NoUnused.CustomTypeConstructorArgs.rule
    , NoUnused.Exports.rule
    , NoUnused.Modules.rule
    , NoUnused.Parameters.rule
    , NoUnused.Patterns.rule
    ]


{-| Facts-driven Cem rules — validate usage of the TypedSvg.\* API in consumer
code. These read TypedSvg.Review.Facts.facts (generated, in src/) to know
per-component enums, slots, valid slot kinds, etc.

The generated library and the verify fixtures are excluded (they are the
implementation being tested, not consumers of it).

-}
codegenAware : List Rule
codegenAware =
    let
        facts =
            TypedSvg.Review.Facts.facts
    in
    [ Cem.validEnumValue facts
    , Cem.requireSlot facts
    , Cem.singularSlot facts
    , Cem.singularAttribute facts
    , Cem.missingRequiredAttribute facts
    , Cem.missingRequiredSingularSlot facts
    , Cem.validSlotKindWith Cem.Lenient facts

    -- Relational composition (families/a11y plan Task 6/7): the ancestor/
    -- descendant complement to validSlotKind. For this brand the live family
    -- is (d) the SVG-AAM overlay — a `role`/`aria-roledescription` attribute
    -- setter on a non-rendered element (`defs`, `clipPath`, `mask`,
    -- `pattern`, `filter`, `animate*`, `set`, `discard`) is a WARN violation.
    -- Uses the default WHATWG/ARIA/SVG-AAM tables, which key the SVG-AAM half
    -- by the plain SVG element nouns this brand's facts already use verbatim.
    , Cem.validComposition facts

    -- Barrel is the canonical surface: `TypedSvg.defs [ … ] [ … ]`.
    -- `elm-review --fix` migrates either direction.
    , Cem.preferBarrel facts
    ]
