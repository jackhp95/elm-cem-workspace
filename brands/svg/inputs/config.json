  "_comment_nesting": [
    "SVG's content model is deliberately permissive: container elements (svg, g, defs, symbol, a, switch,",
    "pattern, mask, clipPath, marker) accept essentially any SVG content, so they admit `any`. Leaf shapes",
    "admit only the accessibility descriptors title/desc. Gradients admit their `stop` children. Text",
    "admits tspan/textPath runs plus the shared `text` content atom. Produced kinds default to the tag",
    "name (a `stop` produces kind `stop`, admitted by a gradient's `[\"stop\"]` slot), so most elements need",
    "no explicit `kind` — only their `home` module grouping and `admits`."
  ],

  "Svg": { "home": "Structure", "admits": { "unnamed": { "kinds": ["any"], "multi": true } } },
  "G": { "home": "Structure", "admits": { "unnamed": { "kinds": ["any"], "multi": true } } },
  "Defs": { "home": "Structure", "admits": { "unnamed": { "kinds": ["any"], "multi": true } } },
  "Symbol": { "home": "Structure", "admits": { "unnamed": { "kinds": ["any"], "multi": true } } },
  "A": { "home": "Structure", "transparent": true, "admits": { "unnamed": { "kinds": ["any"], "multi": true } } },
  "Switch": { "home": "Structure", "admits": { "unnamed": { "kinds": ["any"], "multi": true } } },
  "Use": { "home": "Structure", "admits": { "unnamed": { "kinds": ["title", "desc"], "multi": true } } },

