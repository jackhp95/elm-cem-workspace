{
  "name": "elm-typed-html",
  "version": "0.1.0",
  "private": true,
  "description": "Type-safe native HTML for Elm — the TypedHtml brand (generated by elm-cem).",
  "license": "BSD-3-Clause",
  "author": "jackhp95",
  "scripts": {
    "postinstall": "elm-tooling install",
    "gen": "bash scripts/regen.sh",
    "format": "node_modules/.bin/elm-format verify/src/ verify/bad/ --yes",
    "check:format": "node_modules/.bin/elm-format verify/src/ verify/bad/ --validate",
    "check:review": "node_modules/.bin/elm-review --config review",
    "check:validate": "node scripts/validate.mjs",
    "check:acid": "bash verify/run.sh",
    "check:whatwg": "node scripts/check-whatwg.mjs",
    "check:drift": "bash scripts/regen-diff-gate.sh",
    "check": "run-p \"check:*\"",
    "gate": "npm run check",
    "hooks:install": "node ../../../../../tools/hooks-install.mjs"
  },
  "devDependencies": {
    "elm-review": "^2.13.5",
    "elm-tooling": "^1.20.0",
    "npm-run-all2": "^9.0.3"
  }
}
