module ReviewConfig exposing (config)

{-| elm-review configuration for elm-shoelace.

All of `src/` is generated by elm-cem — style, documentation, and unused rules
must not gate on it. The facts-driven Cem.\* rules (ValidEnumValue, RequireSlot,
etc.) run on consumer code only; the generated library itself is excluded.

Run from the repo root:

    npm run check:review

This file is generated by `elm-cem brand-sync` from the family template — it is
byte-identical across brands modulo the `Sl` module prefix. Do not hand-edit;
edit the template in elm-cem/templates/ReviewConfig.elm and re-sync.

-}

import Cem
import NoDebug.Log
import NoDebug.TodoOrToString
import NoUnused.CustomTypeConstructorArgs
import NoUnused.CustomTypeConstructors
import NoUnused.Exports
import NoUnused.Modules
import NoUnused.Parameters
import NoUnused.Patterns
import NoUnused.Variables
import Review.Rule as Rule exposing (Rule)
import Simplify
import Sl.Review.Facts


config : List Rule
config =
    List.map ignoreGenerated correctness
        ++ List.map (ignoreGenerated >> ignoreAcidProbes) unused
        ++ List.map (ignoreGenerated >> ignoreAcidProbes) codegenAware


{-| All of `src/` is generated wholesale — exclude it from every rule.
-}
ignoreGenerated : Rule -> Rule
ignoreGenerated =
    Rule.ignoreErrorsForDirectories [ "src/" ]


{-| The acid probes in `tests/acid/` are standalone compile-time fixtures — they
are never imported by anything, so unused-module/export rules always fire on them
falsely. Exclude them from all unused and cem-usage rules.
-}
ignoreAcidProbes : Rule -> Rule
ignoreAcidProbes =
    Rule.ignoreErrorsForDirectories [ "tests/" ]


{-| Correctness rules — run everywhere (acid probes included, so Debug sneaking
into a probe is caught).
-}
correctness : List Rule
correctness =
    [ Simplify.rule Simplify.defaults
    , NoDebug.Log.rule
    , NoDebug.TodoOrToString.rule
    ]


{-| Unused-code rules. The brand's public API is entirely in generated `src/`,
so there is no hand-written public surface to gate on here. The acid probes
are also excluded (see ignoreAcidProbes).
-}
unused : List Rule
unused =
    [ NoUnused.Variables.rule
    , NoUnused.CustomTypeConstructors.rule []
    , NoUnused.CustomTypeConstructorArgs.rule
    , NoUnused.Exports.rule
    , NoUnused.Modules.rule
    , NoUnused.Parameters.rule
    , NoUnused.Patterns.rule
    ]


{-| Facts-driven Cem rules — validate usage of the Sl.\* API in consumer code.
These read Sl.Review.Facts.facts (generated, in src/) to know valid enum values,
required slots, valid slot kinds, etc.

The generated library and the acid probes are excluded (they are the
implementation being tested, not consumers of it).

-}
codegenAware : List Rule
codegenAware =
    let
        facts =
            Sl.Review.Facts.facts
    in
    [ Cem.validEnumValue facts
    , Cem.requireSlot facts
    , Cem.singularSlot facts
    , Cem.singularAttribute facts
    , Cem.missingRequiredAttribute facts
    , Cem.missingRequiredSingularSlot facts
    , Cem.validSlotKindWith Cem.Lenient facts

    -- Relational composition (families/a11y plan Task 6/7): the ancestor/
    -- descendant complement to validSlotKind — interactive-content descendant at
    -- ARBITRARY DEPTH + label single-labeled-control (HARD, WHATWG), and ARIA
    -- required-context (WARN: a `menuItem` needs a `menu`/`menubar` ancestor, a
    -- `tab` needs its `tabGroup`). The default config's camelCase noun keys
    -- match the generated ctor nouns verbatim, so no brand-specific config.
    , Cem.validComposition facts

    -- Barrel is the canonical surface family-wide: the one-import
    -- `Sl.button [ Sl.variant … ] …` form. `elm-review --fix` migrates either direction.
    , Cem.preferBarrel facts

    -- ESCAPE DISCIPLINE. The generated `Sl.Unsafe` / `.Unsafe.Attributes`
    -- surface is a last resort, not a convenience: an escape used where a typed
    -- setter exists discards the slot-kind checking, the content model, and the
    -- capability row the substrate exists to provide.
    --
    -- Three layers, because each catches what the others structurally cannot:
    -- the import fence fires once per module and is the only layer that says
    -- "this module has no business holding an escape at all"; the use-level
    -- rules name the specific call AND the typed alternative, which the fence
    -- cannot; the forge rule catches a blessed adapter re-implementing a plain
    -- tag the native brand already provides.
    --
    -- `globalAttributes` is generated (see `Sl.Review.Facts`), so the
    -- element-independent vocabulary cannot drift from the setters it guards.
    -- Attributes outside it are element-SPECIFIC and deliberately unreported:
    -- from an escape call site, `content` on a `<meta>` is indistinguishable
    -- from `content` on a custom element that gives the name its own meaning.
    , Cem.redundantElementEscape { seamEscapes = [] } facts
    , Cem.redundantAttributeEscape
        { setterModules = []
        , globalAttributes = Sl.Review.Facts.globalAttributes
        }
        facts
    ]
