#!/bin/sh
# hooks/pre-push — the ONE workspace-root pre-push gate (fixes findings
# 1.2/1.3/1.4 of docs/reviews/2026-08-17-thermonuclear-workspace-review.md).
#
# Before this file, seven folded-in packages (elm-cem, elm-review-cem,
# cem-figma-connect, elm-typed-html, elm-html-intermediate-representation,
# elm-m3e, m3e-okf) each shipped their own `hooks:install` writing the SAME
# repo-global `core.hooksPath` key — last one run wins, silently discarding
# whichever package's hook was wired before it, and `tailwind-m3e-web` had no
# hook at all. There is exactly ONE git repository here (this workspace); a
# single git repo has exactly one `core.hooksPath`, so per-package hook
# wiring was never actually possible once those packages were folded in
# (see GAUNTLET-LEDGER.md D-008). This file is the single source of truth.
#
# It runs the REAL full-workspace gate (`node tools/gate-all.mjs` — the exact
# command root CI also runs, see .github/workflows/ci.yml), so a red tree
# cannot reach origin in the first place. Local verification is the primary
# gate for this family; CI is the backstop for a clean-checkout / different-OS
# run.
#
# Enable with `pnpm run hooks:install` from anywhere in the workspace — every
# package's own `hooks:install` script now delegates here too (see
# tools/hooks-install.mjs), so old muscle-memory (`pnpm --filter elm-m3e run
# hooks:install`) converges on this SAME hook instead of fighting over the key.
#
# Escape hatches, in order of preference:
#   git push --no-verify      one-off bypass
#   SKIP_GATE=1 git push      same, but explicit about what is being skipped
#
# Ref deletions skip the gate: there is no tree to verify, and `git push --delete`
# during branch cleanup should not pay for a full gate-all run.
#
# SOURCED EXTENSIONS: after the gate passes, this hook sources every
# executable `*.sh` file in hooks/pre-push.d/, in sorted order, passing the
# captured stdin refs via $PRE_PUSH_REFS. This replaces per-package hooks that
# used to do more than just run a gate (e.g. elm-m3e's Netlify prebuilt-dist
# auto-commit) — those become extensions here instead of a competing hook.

set -e

if [ "${SKIP_GATE:-}" = "1" ]; then
  echo "pre-push: SKIP_GATE=1 — gate skipped."
  exit 0
fi

# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha> per ref being pushed.
# An all-zero local sha means "delete this ref". If every line is a deletion,
# there is nothing to test. Capture stdin ONCE (it's a stream) — extensions
# under hooks/pre-push.d/ may need it too.
PRE_PUSH_REFS=$(cat)
export PRE_PUSH_REFS

only_deletions=1
saw_ref=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "$local_sha" ] && continue
  saw_ref=1
  case "$local_sha" in
    *[!0]*) only_deletions=0 ;;
  esac
done <<EOF
$PRE_PUSH_REFS
EOF

if [ "$saw_ref" = "1" ] && [ "$only_deletions" = "1" ]; then
  echo "pre-push: deletion-only push — gate skipped."
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

echo "pre-push: running \`node tools/gate-all.mjs\` ..."
if ! node tools/gate-all.mjs; then
  echo ""
  echo "pre-push: gate-all FAILED — push aborted."
  echo "          Fix it, or bypass deliberately with: git push --no-verify"
  exit 1
fi

echo "pre-push: gate-all passed."

if [ -d "$repo_root/hooks/pre-push.d" ]; then
  for ext in "$repo_root"/hooks/pre-push.d/*.sh; do
    [ -e "$ext" ] || continue
    [ -x "$ext" ] || continue
    echo "pre-push: running extension $(basename "$ext") ..."
    remote_name="$1"
    . "$ext"
  done
fi
